# Cashfree PG credentials — set these in Vercel (Project → Settings → Environment Variables).
# NEVER commit real keys. Get them from the Cashfree dashboard → Developers → API Keys.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 'test' for sandbox, 'production' for live payments (requires KYC-activated production keys)
CASHFREE_ENV=test
