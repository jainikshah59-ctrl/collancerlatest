# Cashfree PG credentials — set these in Vercel (Project → Settings → Environment Variables).
# NEVER commit real keys. Get them from the Cashfree dashboard → Developers → API Keys.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 'test' for sandbox, 'production' for live payments (requires KYC-activated production keys)
CASHFREE_ENV=test

# Google Cloud Storage media uploads (server-only)
# Create a bucket in Google Cloud and set this to its exact name in Vercel.
GCS_BUCKET=
# FIREBASE_SERVICE_ACCOUNT_JSON is already used by lib/firebaseAdmin.js.
# Set it in Vercel only; never commit the actual service-account JSON.

FIREBASE_SERVICE_ACCOUNT_JSON=
