# Cashfree PG credentials — set these in Vercel (Project → Settings → Environment Variables).
# NEVER commit real keys. Get them from the Cashfree dashboard → Developers → API Keys.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 'test' for sandbox, 'production' for live payments (requires KYC-activated production keys)
CASHFREE_ENV=test

# Cloudflare R2 media uploads (server-only; never use VITE_ prefixes for these secrets).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public custom domain mapped to the R2 bucket, e.g. https://media.example.com (no trailing slash).
R2_PUBLIC_BASE_URL=
# Firebase Admin credentials are already used by lib/firebaseAdmin.js; configure in Vercel only.
FIREBASE_SERVICE_ACCOUNT_JSON=
